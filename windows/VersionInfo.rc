#include <windows.h>
#include "LinthesiaVersion.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION LINTHESIA_VERSION_NUMBER
 PRODUCTVERSION LINTHESIA_VERSION_NUMBER
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE LINTHESIA_FILE_TYPE
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", LINTHESIA_FILE_DESCRIPTION "\0"
            VALUE "FileVersion", LINTHESIA_VERSION_STRING "\0"
            VALUE "OriginalFilename", LINTHESIA_ORIGINAL_FILENAME "\0"
            VALUE "ProductName", "Linthesia\0"
            VALUE "ProductVersion", LINTHESIA_VERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
